<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Smart_Agriculrture.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - Smart Agriculture</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: #f8f9fa;
        }
        .navbar {
            backdrop-filter: blur(10px);
            background-color: rgba(33, 37, 41, 0.95);
        }
        .nav-link {
            font-weight: 500;
            transition: color 0.3s;
        }
        .nav-link:hover {
            color: #198754 !important; /* Bootstrap success color */
        }
        .footer {
            background-color: #212529;
            color: #adb5bd;
        }
        .footer .text-white {
            color: #fff !important;
        }
        .footer a.text-white:hover {
            color: #f8f9fa !important;
            opacity: 0.8;
        }
    </style>
</head>
<body>
    <form runat="server" class="d-flex flex-column h-100">
        <asp:ScriptManager runat="server"></asp:ScriptManager>

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" runat="server" href="~/">
                    <i class="bi bi-tree-fill text-success"></i> Smart Agriculture
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2">
                        <li class="nav-item">
                            <a class="nav-link px-3" runat="server" href="~/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" runat="server" href="~/UpcommingWeather">Live Weather</a>
                        </li>

                        <!-- Products Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3" href="#" id="productsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Products
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="productsDropdown">
                                <li><a class="dropdown-item py-2" runat="server" href="~/IrrigationSystem"><i class="bi bi-water me-2 text-primary"></i> Irrigation System</a></li>
                                <!-- Add more products here if needed -->
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3" runat="server" href="~/About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" runat="server" href="~/Contact">Contact</a>
                        </li>
                    </ul>

                    <!-- Login Button -->
                    <div class="d-flex ms-lg-3">
                        <a class="btn btn-outline-success fw-bold px-4 rounded-pill" runat="server" href="~/Login">Login</a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content Wrapper -->
        <div class="flex-shrink-0" style="padding-top: 80px;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <!-- Footer -->
        <footer class="footer mt-auto py-5">
            <div class="container">
                <div class="row gy-4">
                    <div class="col-lg-4 col-md-6 mb-4 mb-md-0">
                        <h5 class="text-white mb-3 fw-bold"><i class="bi bi-tree-fill text-success me-2"></i> Smart Agriculture</h5>
                        <p class="small">Empowering farmers with IoT solutions for a sustainable and efficient future. Join the revolution today.</p>
                        <div class="d-flex gap-3 mt-3">
                            <a href="#" class="text-white text-decoration-none fs-5"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="text-white text-decoration-none fs-5"><i class="bi bi-twitter-x"></i></a>
                            <a href="#" class="text-white text-decoration-none fs-5"><i class="bi bi-linkedin"></i></a>
                            <a href="#" class="text-white text-decoration-none fs-5"><i class="bi bi-instagram"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6 mb-4 mb-md-0">
                        <h6 class="text-uppercase fw-bold mb-3 text-white">Quick Links</h6>
                        <ul class="text-white list-unstyled mb-0 d-flex flex-column gap-2">
                            <li><a runat="server" href="~/" class="text-white text-decoration-none text-muted hover-white">Home</a></li>
                            <li><a runat="server" href="~/About" class="text-white text-decoration-none text-muted hover-white">About Us</a></li>
                            <li><a runat="server" href="~/Contact" class="text-white text-decoration-none text-muted hover-white">Contact</a></li>
                            <li><a runat="server" href="~/Login" class="text-white text-decoration-none text-muted hover-white">Login</a></li>
                            <li><a href="Question/control.html" class="text-white text-decoration-none text-muted hover-white">Question Papers</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-4 mb-md-0">
                        <h6 class="text-uppercase fw-bold mb-3 text-white">Contact</h6>
                        <ul class="text-white list-unstyled mb-0 text-muted d-flex flex-column gap-2">
                            <li><i class="bi bi-geo-alt me-2"></i> Silda, West Bengal 721515</li>
                            <li><i class="bi bi-envelope me-2"></i> rijukarmakar7319@gmail.com</li>
                            <li><i class="bi bi-telephone me-2"></i> +91 98765 43210</li>
                        </ul>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-4 mb-md-0">
                        <h6 class="text-uppercase fw-bold mb-3 text-white">Newsletter</h6>
                        <p class="text-white small text-muted">Subscribe to get the latest updates.</p>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" placeholder="Email" aria-label="Email" aria-describedby="button-addon2">
                            <button class="btn btn-outline-success" type="button" id="button-addon2"><i class="bi bi-send"></i></button>
                        </div>
                    </div>
                </div>
                <hr class="my-4 border-secondary opacity-25">
                <div class="text-center small text-muted">
                    &copy; <%: DateTime.Now.Year %> Smart Agriculture. All rights reserved.
                </div>
            </div>
        </footer>
    </form>

    <!-- Bootstrap JS + Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
